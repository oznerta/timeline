#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# OmniGate AI — Pre-Commit Safeguard Hook
#
# Prevents committing secrets or breaking code.
# To enable this hook in your repository, run:
#   cp .omnigate/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
# ──────────────────────────────────────────────────────────────
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}[OmniGate Pre-Commit] Running secret & safety check...${NC}"

# 1. Check for staged secrets
SECRET_PATTERNS='(API_KEY|SECRET_KEY|PRIVATE_KEY|AWS_SECRET|DATABASE_URL|PASSWORD|BEARER_TOKEN)\s*=\s*["'\'']?[A-Za-z0-9_\-]{8,}'

if git diff --cached --name-only | xargs grep -E -n "$SECRET_PATTERNS" 2>/dev/null; then
  echo -e "${RED}[ERROR] Staged files contain potential hardcoded secrets!${NC}"
  echo -e "${YELLOW}Please replace secrets with environment variables or placeholders per .omnigate/rules/secret-handling.md.${NC}"
  exit 1
fi

echo -e "${GREEN}✓ No secret leakage detected in staged diffs.${NC}"
