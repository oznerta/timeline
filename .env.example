# Application URL (for email links and invite redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Delivery Configuration (Optional / Recommended)
# Get a free API key with 3,000 free emails/month at https://resend.com/api-keys
# If left blank, the app will run in simulated email mode without failing.
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=Weekline <onboarding@resend.dev>

# Production Supabase PostgreSQL Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
